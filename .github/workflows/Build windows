name: Build Windows Static Library

on:
  push:
    branches: [ main, master, develop, '*' ]
  pull_request:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest

    steps:
    - uses: actions/checkout@v4
      with:
        submodules: recursive

    # CMake（GitHub runner其实自带，但这里保险）
    - name: Setup CMake
      uses: lukka/get-cmake@latest

    # 配置（MSVC）
    - name: Configure
      run: |
        cmake -S . -B build ^
          -G "Visual Studio 17 2022" ^
          -A x64 ^
          -DCMAKE_BUILD_TYPE=Release ^
          -DCAPSTONE_BUILD_TESTS=OFF ^
          -DCAPSTONE_BUILD_SHARED=OFF ^
          -DCAPSTONE_BUILD_STATIC=ON ^
          -DCAPSTONE_ARM_SUPPORT=ON ^
          -DCAPSTONE_ARM64_SUPPORT=ON

    # 编译
    - name: Build
      run: |
        cmake --build build --config Release --target capstone

    # 打包
    - name: Package
      run: |
        mkdir package

        copy build\Release\capstone.lib package\

        mkdir package\include
        xcopy include package\include\ /E /I /Y

    # 压缩
    - name: Archive
      run: |
        powershell Compress-Archive -Path package\* -DestinationPath capstone-windows.zip

    # 上传
    - name: Upload Artifact
      uses: actions/upload-artifact@v4
      with:
        name: capstone-windows
        path: capstone-windows.zip
