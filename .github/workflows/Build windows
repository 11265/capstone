name: Build Windows Static Library

on:
  push:
    branches: [ main, master, develop, '*' ]
  pull_request:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest

    steps:
    - uses: actions/checkout@v4
      with:
        submodules: recursive

    # 安装 CMake
    - name: Install CMake
      uses: lukka/get-cmake@latest

    # 配置工程（等价 iOS cmake 参数）
    - name: Configure (MSVC x64)
      run: |
        mkdir build
        cd build

        cmake .. ^
          -G "Visual Studio 17 2022" ^
          -A x64 ^
          -DCMAKE_BUILD_TYPE=Release ^
          -DCAPSTONE_ARM64_SUPPORT=ON ^
          -DCAPSTONE_ARM_SUPPORT=ON ^
          -DCAPSTONE_BUILD_TESTS=OFF ^
          -DCAPSTONE_BUILD_SHARED=OFF ^
          -DCAPSTONE_BUILD_STATIC=ON ^
          -DCMAKE_C_FLAGS="/wd4244" ^
          -DCMAKE_CXX_FLAGS="/wd4244"

    # 编译
    - name: Build
      run: |
        cmake --build build --config Release --target capstone

    # 打包
    - name: Package Library
      run: |
        mkdir package

        copy build\Release\capstone.lib package\

        mkdir package\include\capstone
        xcopy include\* package\include\capstone\ /E /I /Y

    # 压缩
    - name: Zip Artifact
      run: |
        powershell Compress-Archive -Path package\* -DestinationPath capstone-windows.zip

    # 上传
    - name: Upload Artifact
      uses: actions/upload-artifact@v4
      with:
        name: capstone-windows
        path: capstone-windows.zip
